# LocalFileHandler Configuration
# Copy to .env and customize as needed

# Workspace — root directory for all managed files
WORKSPACE_PATH=./workspace

# Naming rules
NAMING_DATE_FORMAT=%Y-%m-%d
NAMING_CASE_STYLE=kebab
NAMING_AUTO_CATEGORIZE=true
NAMING_DATE_PREFIX=true
NAMING_NORMALIZE_EXTENSIONS=true
NAMING_HANDLE_DUPLICATES=increment

# Server settings
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# Trash / safe delete
TRASH_ENABLED=true
TRASH_DIR=.trash

# Limits
MAX_FILE_SIZE_MB=100
